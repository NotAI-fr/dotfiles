#!/usr/bin/env bash
set -u

APP_DIR="${XDG_CONFIG_HOME:-${HOME}/.config}/polybar/scripts/psn"
PYTHON="${APP_DIR}/venv/bin/python"
SCRIPT="${APP_DIR}/psn_friends.py"
COMMAND="${1:-status}"

if [[ ! -x "${PYTHON}" || ! -f "${SCRIPT}" ]]; then
    printf 'PSN Polybar runtime is incomplete. Run:\n  %s/setup.sh repair\n' "${APP_DIR}" >&2
    exit 127
fi

run_timed() {
    local duration="$1"
    local mode="$2"
    shift 2

    timeout --foreground --signal=TERM --kill-after=5s "${duration}" \
        "${PYTHON}" -u "${SCRIPT}" "$@"
    local rc=$?

    if (( rc == 124 || rc == 137 )); then
        "${PYTHON}" -u "${SCRIPT}" mark-timeout "${mode}" >/dev/null 2>&1 || true
    fi
    return "${rc}"
}

case "${COMMAND}" in
    presence-worker)
        run_timed 90s presence "$@"
        ;;
    full-worker)
        run_timed 6m full "$@"
        ;;
    refresh|refresh-friends)
        run_timed 6m full "$@"
        ;;
    refresh-presence|test-auth)
        run_timed 90s presence "$@"
        ;;
    *)
        exec "${PYTHON}" -u "${SCRIPT}" "$@"
        ;;
esac
