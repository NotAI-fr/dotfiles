{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "builtin",
        "source": "arch",
        "padding": {
            "top": 2,
            "right": 3
        }
    },
    "display": {
        "separator": " "
    },
    "modules": [
        "break",
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break",
        {
            "type": "title",
            "keyWidth": 10
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m  \u001b[1mSoftware\u001b[0m \u001b[34m"
        },
        {
            "type": "os",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "kernel",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "packages",
            "format": "{} (pacman)",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "shell",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "wm",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "terminal",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "uptime",
            "key": " ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m  \u001b[1mHardware\u001b[0m \u001b[34m"
        },
        {
            "type": "cpu",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "gpu",
            "key": "󰘚 ",
            "keyColor": "34"
        },
        {
            "type": "memory",
            "key": " ",
            "keyColor": "34"
        },
        {
            "type": "disk",
            "key": "󰋊 ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[34m  \u001b[1mMedia\u001b[0m \u001b[34m"
        },
        {
            "type": "media",
            "key": "󰝚 ",
            "keyColor": "34"
        },
        {
            "type": "player",
            "key": " ",
            "keyColor": "34"
        },
        "break",
        {
            "type": "custom",
            "format": "\u001b[90m  \u001b[31m  \u001b[32m  \u001b[33m  \u001b[34m  \u001b[35m  \u001b[36m  \u001b[37m"
        },
        "break"
    ]
}
