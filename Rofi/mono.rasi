* {
    /* 0, 0, 0 is Black | 0.8 is the transparency (80% opacity) */
    background-color: rgba(0, 0, 0, 0.8);
    text-color:       #D3D3D3;
    font:             "monospace 14";
    border-radius:    0px;
}

window {
    border:           1px;
    border-color:     #D3D3D3;
    padding:          20px;
    width:            32%;
    height:           60%;
    location:         center;
}

inputbar {
    children:         [ entry ];
    border:           0px 0px 2px 0px;
    border-color:     #D3D3D3;
    padding:          0px 0px 10px 0px;
    margin:           0px 0px 20px 0px;
}

/* You can safely keep or delete the 'prompt' block below;
   since it's no longer a child of the inputbar, it won't render anyway */
prompt {
    margin:           0px 10px 0px 0px;
}

element {
    padding:          5px;
    border:           1px;
    border-color:     #222222;
    margin:           0px 0px 5px 0px;
}

/* Keeps the active highlight stark solid white for contrast */
element selected {
    background-color: #D3D3D3;
    text-color:       #000000;
}
