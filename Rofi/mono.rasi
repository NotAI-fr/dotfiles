* {
    /* 0, 0, 0 is Black | 0.8 is the transparency (80% opacity) */
    background-color: rgba(0, 0, 0, 0.8);
    text-color:       #ffffff;
    font:             "monospace 14";
    border-radius:    0px;
}

window {
    border:           2px;
    border-color:     #ffffff;
    padding:          20px;
    width:            32%;
    height:           60%;
    location:         center;
}

inputbar {
    children:         [ prompt, entry ];
    border:           0px 0px 2px 0px;
    border-color:     #ffffff;
    padding:          0px 0px 10px 0px;
    margin:           0px 0px 20px 0px;
}

prompt {
    margin:           0px 10px 0px 0px;
}

element {
    padding:          10px;
    border:           1px;
    border-color:     #222222;
    margin:           0px 0px 5px 0px;
}

/* Keeps the active highlight stark solid white for contrast */
element selected {
    background-color: #ffffff;
    text-color:       #000000;
}
