configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
}

@import "colors.rasi"
@import "fonts.rasi"

window {
    transparency: "real";
    location: center;
    anchor: center;
    fullscreen: false;
    width: 700px;
    height: 600px;
    x-offset: 0px;
    y-offset: 0px;

    margin: 0px;
    padding: 0px;
    border: 2px solid;
    border-radius: 8px;
    border-color: var(selected);
    cursor: "default";
    background-color: var(background);
}

mainbox {
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    background-color: transparent;
    children: [ "inputbar", "listview" ];
}

inputbar {
    spacing: 0px;
    margin: 0px;
    padding: 0px;
    border: 0px 0px 1px 0px;
    border-radius: 0px;
    border-color: var(background-alt);
    background-color: var(background);
    text-color: var(foreground);
    children: [ "entry" ];
}

entry {
    padding: 15px;
    background-color: inherit;
    text-color: inherit;
    cursor: text;
    placeholder: "Search Wallpapers...";
    placeholder-color: inherit;
}

listview {
    columns: 3;
    lines: 3;
    cycle: true;
    dynamic: true;
    scrollbar: false;
    layout: vertical;
    reverse: false;
    fixed-height: true;
    fixed-columns: true;

    spacing: 15px;
    margin: 15px;
    padding: 0px;
    border: 0px solid;
    border-radius: 0px;
    background-color: transparent;
    text-color: var(foreground);
    cursor: "default";
}

element {
    orientation: vertical;
    spacing: 10px;
    margin: 0px;
    padding: 15px;
    border: 0px solid;
    border-radius: 8px;
    background-color: transparent;
    text-color: var(foreground);
    cursor: pointer;
}

element normal.normal {
    background-color: var(background);
    text-color: var(foreground);
}

element selected.normal {
    background-color: var(background-alt);
    text-color: var(foreground);
    border: 2px solid;
    border-color: var(selected);
}

element-icon {
    background-color: transparent;
    text-color: inherit;
    size: 160px;
    cursor: inherit;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    cursor: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.5;
}
