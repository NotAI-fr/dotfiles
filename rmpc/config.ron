#![enable(implicit_some)]
#![enable(unwrap_newtypes)]
#![enable(unwrap_variant_newtypes)]
(
    address: "127.0.0.1:6600",
    volume_step: 5,
    scrolloff: 2,
    max_fps: 60,
    wrap_navigation: true,
    theme: "colors",
    cache_dir: Some("/tmp/rmpc/cache"),
    lyrics_dir: Some("/home/nobloat/Music"),
    enable_lyrics_hot_reload: true,
    enable_lyrics_index: true,
    status_update_interval_ms: 1000,
    enable_mouse: true,
    enable_config_hot_reload: true,

    album_art: (
        method: Auto,
        max_size_px: (width: 1200, height: 1200),
        vertical_align: Top,
        horizontal_align: Center,
    ),

    keybinds: (
        clear: true,

        global: {
            "q":       Quit,
            "?":       ShowHelp,
            "u":       Update,
            "C":       ToggleConsume,
            "O":       ShowOutputs,
            "I":       ShowCurrentSongInfo,
            "<C-p>":   ShowDecoders,
            ":":       CommandMode,
            ".":       VolumeUp,
            ",":       VolumeDown,
            "p":       TogglePause,
            "s":       Stop,
            ">":       NextTrack,
            "<":       PreviousTrack,

            // Tab switching: arrows are intentionally NOT used here.
            "<Tab>":   NextTab,
            "<S-Tab>": PreviousTab,
            "1":       SwitchToTab("Queue"),
            "2":       SwitchToTab("Directories"),
            "3":       SwitchToTab("Album Artists"),
            "4":       SwitchToTab("Playlists"),
            "5":       SwitchToTab("Search"),

            "z":       ToggleRepeat,
            "x":       ToggleRandom,
            "c":       ToggleSingle,
            "f":       SeekForward,
            "b":       SeekBack,
        },

        navigation: {
            // Normal arrow-key navigation.
            "<Up>":      Up,
            "<Down>":    Down,
            "<Left>":    Left,
            "<Right>":   Right,

            "<S-Up>":    PaneUp,
            "<S-Down>":  PaneDown,
            "<S-Left>":  PaneLeft,
            "<S-Right>": PaneRight,

            "<C-u>":     UpHalf,
            "N":         PreviousResult,
            "a":         Add,
            "A":         AddAll,
            "r":         Rename,
            "n":         NextResult,
            "g":         Top,
            "<Space>":   Select,
            "G":         Bottom,
            "h":         Left,
            "<CR>":      Confirm,
            "i":         FocusInput,
            "J":         MoveDown,
            "j":         Down,
            "<C-d>":     DownHalf,
            "/":         EnterSearch,
            "<C-c>":     Close,
            "<Esc>":     Close,
            "K":         MoveUp,
            "l":         Right,
            "D":         Delete,
            "k":         Up,
            "B":         ShowInfo,

            // Playlist saving.
            // Shift+P: save the song under the cursor to a playlist.
            // If songs are marked with Space, RMPC applies this action to those marked songs.
            "P":         Save(kind: Modal(all: false, duplicates_strategy: Ask)),

            // Shift+S: save the entire current queue/directory to a playlist.
            "S":         Save(kind: Modal(all: true, duplicates_strategy: Ask)),

            // Ctrl+S: save marked/selected songs to a playlist.
            // If nothing is marked, this falls back to the song under the cursor.
            "<C-s>":     Save(kind: Modal(all: false, duplicates_strategy: Ask)),
        },

        queue: {
            "D":     DeleteAll,
            "<CR>":  Play,
            "X":     Shuffle,
            "d":     Delete,
        },
    ),

    search: (
        case_sensitive: false,
        mode: Contains,
        tags: [
            (value: "any",         label: "Any Tag"),
            (value: "artist",      label: "Artist"),
            (value: "album",       label: "Album"),
            (value: "albumartist", label: "Album Artist"),
            (value: "title",       label: "Title"),
        ],
    ),

    tabs: [
        (
            name: "Queue",
            pane: Split(
                direction: Horizontal,
                panes: [
                    (
                        size: "30%",
                        borders: "RIGHT",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "70%",
                                    pane: Pane(AlbumArt),
                                ),
                                (
                                    size: "30%",
                                    borders: "TOP",
                                    pane: Pane(Lyrics),
                                ),
                            ],
                        ),
                    ),
                    (
                        size: "70%",
                        pane: Split(
                            direction: Vertical,
                            panes: [
                                (
                                    size: "1",
                                    pane: Pane(QueueHeader()),
                                ),
                                (
                                    size: "100%",
                                    pane: Pane(Queue),
                                ),
                            ],
                        ),
                    ),
                ],
            ),
        ),

        (
            name: "Directories",
            pane: Pane(Directories),
        ),
        (
            name: "Album Artists",
            pane: Pane(AlbumArtists),
        ),
        (
            name: "Playlists",
            pane: Pane(Playlists),
        ),
        (
            name: "Search",
            pane: Pane(Search),
        ),
    ],
)
