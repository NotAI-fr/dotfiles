# ===========================
# Kitty Terminal Configuration
# ===========================

# Font
font_family FiraMonoNerdFont
font_size 12

# Window size
initial_window_width 140
initial_window_height 35

# Colors
# foreground #c0c0c0
# background #1e1e1e
# selection_foreground #c0c0c0
# selection_background #330000

# Cursor
# cursor #9c0800

# Transparency
background_opacity 0.75

# Scrollbar
scrollbar_position none

# Window decorations
decorations none

# Padding (outer padding around window)
padding 5 5 5 5

# Enable true color
enable_true_color yes


# Extra inner padding inside splits
window_padding_width 3


# BEGIN_KITTY_THEME
# Adapta Nokto Maia
include current-theme.conf
# END_KITTY_THEME
