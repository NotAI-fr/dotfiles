# Set modifier key to Super/Windows key
set $mod Mod4

# Font for window titles (kept small and minimal)
font pango:monospace 8

# Core window styling - sharp 2px borders, no titlebars
default_border pixel 2
default_floating_border pixel 2
gaps inner 8
gaps outer 4

# Stark Monochrome Color Palette
set $black       #000000
set $dark_gray   #222222
set $mid_gray    #555555
set $light_gray  #aaaaaa
set $white       #ffffff

# Window coloring rules
# class                 border      bground     text        indicator   child_border
client.focused          $white      $black      $white      $white      $white
client.focused_inactive $dark_gray  $black      $light_gray $dark_gray  $dark_gray
client.unfocused        $dark_gray  $black      $mid_gray   $dark_gray  $dark_gray
client.urgent           $white      $white      $black      $white      $white

# Force 5 dedicated workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Core Application Keybinds
bindsym $mod+Return exec kitty
bindsym $mod+q kill
bindsym $mod+Shift+r restart
bindsym $mod+f exec firefox
bindsym $mod+l exec betterlockscreen -l
bindsym $mod+S exec maim -s -u | xclip -selection clipboard -t image/png

# Launch Rofi Menus (Apps, Wallpapers, and Power)
bindsym $mod+d exec --no-startup-id rofi -show drun -theme /home/nobloat/.config/rofi/mono.rasi
bindsym $mod+w exec --no-startup-id ~/.config/rofi/wallpaper-picker.sh
bindsym $mod+x exec --no-startup-id ~/.config/rofi/power-menu.sh

# Native X11 Dropdown rules (Forces sound control and blueman to floating blocks)
for_window [class="Pavucontrol"] floating enable, border pixel 2, resize set 600 px 400 px
for_window [class="Blueman-manager"] floating enable, border pixel 2, resize set 600 px 400 px

# Auto-run crucial lightweight background utilities on boot
exec --no-startup-id polybar
exec_always --no-startup-id autotiling
exec --no-startup-id dunst
exec --no-startup-id feh --bg-solid '#111111'
# Set external monitor as primary and kill the laptop display
exec --no-startup-id xrandr --output HDMI-1 --auto --primary --output eDP-1 --off
