# Set modifier key to Super/Windows key
set $mod Mod4

# Font for window titles (kept small and minimal)
font FiraMono Nerd Font:12

# 1. LINK THE ACTIVE THEME COLORS HERE (Must be BEFORE window styling)
include colors.conf

# Core window styling - chunky 3px borders for higher brutalist pop, no titlebars
default_border pixel 3
default_floating_border pixel 3
gaps inner 8
gaps outer 4

# Force network and bluetooth tools to open as floating pop-ups
for_window [class="floating_tool"] floating enable, resize set 800 600, move position center



# Force 5 dedicated workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5

bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5

# Core Application Keybinds
bindsym $mod+q exec kitty
bindsym $mod+c kill
bindsym $mod+Shift+r restart
bindsym $mod+f exec helium-browser
bindsym $mod+l exec i3lock-fancy
bindsym $mod+e exec nemo

# Launch Rofi Menus (Apps, Wallpapers, and Power)
bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+w exec --no-startup-id ~/.config/rofi/wallpaper-picker.sh
bindsym $mod+x exec --no-startup-id ~/.config/rofi/power-menu.sh
bindsym $mod+a exec --no-startup-id curd -rofi
bindsym $mod+s exec --no-startup-id maim -s | xclip -selection clipboard -t image/png
bindsym $mod+t exec --no-startup-id /home/nobloat/.config/rofi/theme-switcher.sh


# Native X11 Dropdown rules (Forces sound control and blueman to floating blocks)
for_window [class="Pavucontrol"] floating enable, border pixel 3, resize set 600 px 400 px
for_window [class="Blueman-manager"] floating enable, border pixel 3, resize set 600 px 400 px
for_window [instance="weather_tui"] floating enable, resize set 850 850, move position center

# Auto-run crucial lightweight background utilities on boot
exec --no-startup-id polybar
exec_always --no-startup-id autotiling
exec --no-startup-id /usr/lib/xfce4/notifyd/xfce4-notifyd
exec --no-startup-id feh --bg-solid '#111111'
exec --no-startup-id picom -b
exec --no-startup-id xrandr --output HDMI-2 --mode 1920x1080 --rate 60.00 --primary --output eDP-1 --off
exec --no-startup-id vesktop

# Fix standard mouse pointer tracking on empty workspace roots
exec_always --no-startup-id xsetroot -cursor_name left_ptr

exec_always --no-startup-id xrdb -merge ~/.Xresources

exec --no-startup-id nm-tray
exec --no-startup-id xfce4-clipman
